{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "pinniped-supervisor",
  "type": "object",
  "required": ["image", "replicaCount"],
  "properties": {
    "nameOverride": { "type": "string" },
    "fullnameOverride": { "type": "string" },
    "image": {
      "type": "object",
      "required": ["repository", "pullPolicy"],
      "properties": {
        "repository": { "type": "string", "minLength": 1 },
        "tag": { "type": "string" },
        "digest": { "type": "string" },
        "pullPolicy": { "type": "string", "enum": ["Always", "IfNotPresent", "Never"] }
      }
    },
    "imagePullSecrets": { "type": "array" },
    "replicaCount": { "type": "integer", "minimum": 1 },
    "serviceAccount": {
      "type": "object",
      "properties": {
        "supervisor": {
          "type": "object",
          "properties": {
            "create": { "type": "boolean" },
            "name": { "type": "string" },
            "annotations": { "type": "object" }
          }
        }
      }
    },
    "podAnnotations": { "type": "object" },
    "podLabels": { "type": "object" },
    "podSecurityContext": { "type": "object" },
    "securityContext": { "type": "object" },
    "resources": { "type": "object" },
    "nodeSelector": { "type": "object" },
    "tolerations": { "type": "array" },
    "affinity": { "type": "object" },
    "priorityClassName": { "type": "string" },
    "extraEnv": { "type": "array" },
    "extraVolumes": { "type": "array" },
    "extraVolumeMounts": { "type": "array" },
    "service": {
      "type": "object",
      "properties": {
        "api": {
          "type": "object",
          "properties": {
            "type": { "type": "string", "enum": ["ClusterIP", "NodePort", "LoadBalancer"] },
            "annotations": { "type": "object" }
          }
        },
        "oidc": {
          "type": "object",
          "properties": {
            "type": { "type": "string", "enum": ["ClusterIP", "NodePort", "LoadBalancer"] },
            "annotations": { "type": "object" }
          }
        }
      }
    },
    "apiService": {
      "type": "object",
      "properties": {
        "groupPriorityMinimum": { "type": "integer" },
        "versionPriority": { "type": "integer" }
      }
    },
    "config": { "type": "object" },
    "certificate": {
      "type": "object",
      "required": ["enabled"],
      "properties": {
        "enabled": { "type": "boolean" },
        "hostname": { "type": "string" },
        "clusterIssuer": { "type": "string" },
        "secretName": { "type": "string" },
        "duration": { "type": "string" },
        "renewBefore": { "type": "string" }
      }
    },
    "federationDomains": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "spec": { "type": "object" }
        }
      }
    },
    "oidcIdentityProviders": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "spec": { "type": "object" }
        }
      }
    },
    "ldapIdentityProviders": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "spec": { "type": "object" }
        }
      }
    },
    "activeDirectoryIdentityProviders": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "spec": { "type": "object" }
        }
      }
    },
    "githubIdentityProviders": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "spec": { "type": "object" }
        }
      }
    },
    "oidcClients": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name"],
        "properties": {
          "name": { "type": "string", "minLength": 1, "pattern": "^client\\.oauth\\.pinniped\\.dev-" },
          "spec": { "type": "object" }
        }
      }
    },
    "oidcClientSecrets": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "clientID": { "type": "string" },
          "clientSecret": { "type": "string" }
        }
      }
    },
    "bindSecrets": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "username": { "type": "string" },
          "password": { "type": "string" }
        }
      }
    },
    "githubClientSecrets": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "clientID": { "type": "string" },
          "clientSecret": { "type": "string" }
        }
      }
    },
    "ingress": {
      "type": "object",
      "required": ["enabled"],
      "properties": {
        "enabled": { "type": "boolean" },
        "hostname": { "type": "string" },
        "ingressClassName": { "type": "string" },
        "annotations": { "type": "object" }
      }
    },
    "podDisruptionBudget": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "minAvailable": { "type": ["integer", "string"] }
      }
    },
    "extraManifests": { "type": "array" }
  }
}
